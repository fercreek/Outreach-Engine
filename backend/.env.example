# ── App ──────────────────────────────────────────────────────
APP_NAME="StudioLink Outreach Engine"
DEBUG=true

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./studiolink.db

# ── Browser / Playwright ─────────────────────────────────────
# Path to your Chrome user data directory
# macOS: ~/Library/Application Support/Google/Chrome/Default
# Linux: ~/.config/google-chrome/Default
# Windows: %LOCALAPPDATA%\Google\Chrome\User Data\Default
CHROME_PROFILE_PATH=

# Never run headless in production (anti-detection)
HEADLESS=false

# ── TikTok Safety Limits ─────────────────────────────────────
MIN_DELAY_BETWEEN_DMS_SEC=900
MAX_DELAY_BETWEEN_DMS_SEC=1200
MAX_DMS_PER_DAY=45
MIN_ACTION_DELAY_SEC=45
MAX_ACTION_DELAY_SEC=90

# ── Keystroke Dynamics ───────────────────────────────────────
MIN_KEYSTROKE_DELAY_MS=50
MAX_KEYSTROKE_DELAY_MS=180

# ── CORS (frontend origins) ─────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
